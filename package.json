{
  "name": "harborvoice-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A logistics voice operations workbench powered by ElevenLabs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "agent:provision": "tsx scripts/provision-agent.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "format": "prettier --write src server scripts tests docs/*.md README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml",
    "format:check": "prettier --check src server scripts tests docs/*.md README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "latest",
    "@elevenlabs/react": "latest",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "latest",
    "multer": "^2.0.2",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "latest"
  },
  "engines": {
    "node": ">=22.13"
  }
}
