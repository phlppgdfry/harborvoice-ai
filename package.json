{
  "name": "harborvoice-ai",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "A logistics voice operations workbench powered by ElevenLabs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && npm run build:agentproof",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "agent:provision": "tsx scripts/provision-agent.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "format": "prettier --write src server scripts tests agent api lib config docs README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml vercel.json",
    "format:check": "prettier --check src server scripts tests agent api lib config docs README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml vercel.json",
    "verify:live": "tsx scripts/verify-live.ts",
    "agent:sync": "node --import tsx scripts/elite/resources.ts dry-run",
    "agent:evaluate": "tsx scripts/evaluate-agent.ts",
    "verify:hosted": "tsx scripts/verify-hosted.ts",
    "guest:provision": "tsx scripts/provision-guest.ts",
    "audio:exercise": "tsx scripts/exercise-audio.ts",
    "academy:build": "tsx scripts/build-academy.ts",
    "academy:package": "tsx scripts/package-academy.ts",
    "academy:native": "tsx scripts/academy-native.ts",
    "test:academy": "node --import tsx scripts/verify-academy.ts",
    "elite:budget": "node --import tsx scripts/elite/budget.ts",
    "elite:voices": "node --import tsx scripts/elite/save-voices.ts",
    "resources:inventory": "node --import tsx scripts/elite/resources.ts inventory",
    "sync:dry-run": "node --import tsx scripts/elite/resources.ts dry-run",
    "sync:apply": "node --import tsx scripts/elite/resources.ts apply",
    "sync:drift": "node --import tsx scripts/elite/resources.ts drift",
    "assets:verify": "node --import tsx scripts/elite/validate-assets.ts",
    "elite:validate": "node --import tsx scripts/elite/validate-publication.ts && npm run assets:verify",
    "elite:evaluate": "node --import tsx scripts/elite/evaluate.ts",
    "elite:remediate": "node --import tsx scripts/elite/remediate.ts",
    "budget:report": "node --import tsx scripts/elite/budget.ts report",
    "test:elite": "node --import tsx scripts/elite/browser-check.ts",
    "knowledge:sync": "node --import tsx scripts/elite/knowledge-sync.ts",
    "recognition:budget": "node --import tsx scripts/recognition/budget.ts",
    "recognition:validate": "node --import tsx scripts/recognition/validate-showcase.ts && node --test examples/reliable-agent-workshop/starter.test.mjs",
    "recognition:experiments": "node --import tsx scripts/recognition/experiments.ts",
    "test:community": "node --import tsx scripts/recognition/browser.ts",
    "typecheck": "tsc --noEmit",
    "test:postgres": "node --import tsx scripts/test-postgres.ts",
    "test:production-browser": "node --import tsx scripts/production-browser-check.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "lint": "prettier --check src server scripts tests agent api lib config docs README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml vercel.json",
    "verify:production": "node --import tsx scripts/verify-production-hosted.ts",
    "phase3:verify": "bash scripts/phase3/verify.sh",
    "phase3:browser": "node --import tsx scripts/phase3/browser-check.ts",
    "format:phase3:check": "prettier --check packages/agentops-kit apps/agentproof/src apps/agentproof/*.json apps/agentproof/*.ts apps/agentproof/index.html community/elevenlabs-belgium benchmarks/voice-ai/*.md benchmarks/voice-ai/scenarios scripts/phase3 docs/phase3",
    "build:agentproof": "node --import tsx scripts/final-mastery/build-agentproof.ts",
    "test:contracts": "node --import tsx scripts/final-mastery/contracts.ts",
    "test:mastery": "node --import tsx scripts/final-mastery/browser.ts"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "1.35.0",
    "@elevenlabs/elevenlabs-js": "2.77.0",
    "@elevenlabs/react": "1.21.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "1.70.0",
    "multer": "^2.0.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6",
    "ws": "8.22.1"
  },
  "engines": {
    "node": "24.x"
  }
}
