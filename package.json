{
  "name": "harborvoice-ai",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "A logistics voice operations workbench powered by ElevenLabs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "agent:provision": "tsx scripts/provision-agent.ts",
    "test:browser": "node --import tsx scripts/browser-check.ts",
    "format": "prettier --write src server scripts tests agent api docs/*.md README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml vercel.json",
    "format:check": "prettier --check src server scripts tests agent api docs/*.md README.md index.html package.json tsconfig.json vite.config.ts .github/workflows compose.yaml vercel.json",
    "verify:live": "tsx scripts/verify-live.ts",
    "agent:sync": "tsx scripts/sync-agent.ts",
    "agent:evaluate": "tsx scripts/evaluate-agent.ts",
    "verify:hosted": "tsx scripts/verify-hosted.ts",
    "guest:provision": "tsx scripts/provision-guest.ts",
    "audio:exercise": "tsx scripts/exercise-audio.ts",
    "academy:build": "tsx scripts/build-academy.ts",
    "academy:package": "tsx scripts/package-academy.ts",
    "academy:native": "tsx scripts/academy-native.ts",
    "test:academy": "node --import tsx scripts/verify-academy.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.77.0",
    "@elevenlabs/react": "1.21.1",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "1.70.0",
    "multer": "^2.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  },
  "engines": {
    "node": "24.x"
  }
}
