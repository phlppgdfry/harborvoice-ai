# APP_MODE=demo is only for explicit development/portfolio demonstrations.
# Production (including NODE_ENV=production) validates all required configuration.
APP_MODE=demo
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Local-only operator API. Required outside localhost; enter in Settings.
OPERATOR_TOKEN=
PORT=3100
HOST=127.0.0.1
ELEVENLABS_WEBHOOK_SECRET=
DATABASE_URL=
PUBLIC_ORIGIN=
# Optional durable-file deployment only; never use SQLite on an ephemeral Vercel filesystem.
SQLITE_PATH=var/harborvoice.sqlite
# Optional public trial. Use a separate read-only agent with enforced provider call limits.
ELEVENLABS_GUEST_AGENT_ID=
# Fixed UTC cutoff for new visitor signed-session URLs. Leave empty to disable the trial.
GUEST_VOICE_EXPIRES_AT=
